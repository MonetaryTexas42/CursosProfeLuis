# Plantilla de entorno local (versionada).
#
# Copia este archivo a `.env` y rellena solo con un proyecto de STAGING.
# Deja las variables vacías si aún no tienes proyecto: la app mostrará la
# pantalla de configuración en lugar de intentar conectarse.
#
# No pongas aquí la URL ni la clave de producción. El frontend solo necesita
# la URL del proyecto y la `anon public key`; nunca `service_role` ni la
# cadena `postgresql://...`.
#
# Runbook de staging: app/docs/staging.md

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STUDENT_EMAIL_DOMAIN=alumnos.ecoems.mx
VITE_APP_ENV=local
